{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "site-output",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https://shill1289.github.io https://static.cargurus.com https://bringatrailer.com https://media.carsandbids.com https://images.autotrader.com https://retail.photos.vin https://api.auto.dev; connect-src 'self' https://shill1289.github.io; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/inventory.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "buildCommand": "node scripts/build_site.cjs",
  "ignoreCommand": "node scripts/ignore_vercel_build.cjs",
  "redirects": [
    {
      "source": "/inventory.json",
      "destination": "https://shill1289.github.io/Cruiser-scout/inventory.json",
      "permanent": false
    },
    {
      "source": "/photos/:path*",
      "destination": "https://shill1289.github.io/Cruiser-scout/photos/:path*",
      "permanent": false
    }
  ]
}
